# Endereço público do site (canonical, hreflang, sitemap, Open Graph).
# Vazio: produção usa https://be-front.ai, versões de teste usam o próprio endereço da Vercel.
NEXT_PUBLIC_SITE_URL=
# GA4 (opcional). Sem ele, nenhum script de métricas é carregado
NEXT_PUBLIC_GA_ID=
# Envio do formulário de briefing pelo Resend
RESEND_API_KEY=
BRIEFING_TO=
BRIEFING_FROM=be-front <briefing@befront.example>
